generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id       Int    @id @default(autoincrement())
  name     String
  price    Int
  imageUrl String
  stock    Int    @default(100)
  version  Int    @default(0)
}